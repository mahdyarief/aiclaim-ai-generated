# Kunci API DeepSeek untuk mockup. Dibaca HANYA oleh server.mjs di sisi peladen,
# tidak pernah ikut ke peramban. Jangan menaruh kunci di dalam berkas HTML, 
# berkas HTML itu sering dikirim ke orang lain.
#
# Bila berkas ini tidak ada, server.mjs juga mencoba ../frontend/.env,
# supaya kunci yang sudah ada di proyek frontend bisa langsung dipakai.
DEEPSEEK_API_KEY=

# Pilihan. Bawaan: deepseek-chat
DEEPSEEK_MODEL=deepseek-chat
